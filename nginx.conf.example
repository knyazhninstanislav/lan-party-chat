#user  nobody;
worker_processes  1;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout  65;

    # Определяем зону ограничения скорости: 10 запросов в секунду на IP
    limit_req_zone $binary_remote_addr zone=chat_limit:10m rate=10r/s;

    # Блок HTTPS-сервера
    server {
        listen 443 ssl;
        server_name lanparty.ru;

        # Пути к сертификатам
        ssl_certificate     C:/nginx/conf/ssl/lanparty.crt;
        ssl_certificate_key C:/nginx/conf/ssl/lanparty.key;

        # Вложения уходят на сервер в base64: до 5 файлов по 10 МБ
        # + запас на JSON/overhead. Должно совпадать с MAX_BODY_SIZE.
        client_max_body_size 72m;
        client_body_timeout  60s;
        client_header_timeout 30s;
        send_timeout 60s;

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        # HSTS — только если HTTPS будет всегда
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        location / {
            proxy_pass http://127.0.0.1:5555;
            proxy_http_version 1.1;
            proxy_set_header Connection "";

            # ВАЖНО: $http_host содержит порт (lanparty.ru:443), а $host — нет.
            # Origin браузера будет https://lanparty.ru:443, поэтому Host тоже
            # должен содержать порт, иначе проверка Origin на Python падает с 403.
            proxy_set_header Host              $http_host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host  $http_host;
            proxy_set_header X-Forwarded-Port  $server_port;

            proxy_connect_timeout 10s;
            proxy_read_timeout    120s;
            proxy_send_timeout    120s;

            # Большие вложения не буферизуем целиком на диск
            proxy_request_buffering off;
        }
    }
}